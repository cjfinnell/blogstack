---
import PostLayout from '../../layouts/PostLayout.astro';
import { postPublishedAt, postSlug, postTitle } from '@blogstack/blog-client';
import { blog } from '@blogstack/astro-shared/blog';
import { renderPostHtml } from '@blogstack/astro-shared/post-html';
import { theme } from '../../site';

export const prerender = import.meta.env.RENDER_MODE !== 'ssr';

export async function getStaticPaths() {
  if (!prerender) return [];
  const posts = await blog.getPublishedPosts(100);
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const post = Astro.props.post ?? (await blog.getPostBySlug(Astro.params.slug));
if (!post) Astro.response.status = 404;
const html = post ? await renderPostHtml(post.data?.content, theme) : null;
---

{
  post ? (
    <PostLayout title={postTitle(post)} publishedAt={postPublishedAt(post)}>
      <Fragment set:html={html} />
    </PostLayout>
  ) : (
    <PostLayout title="404 — not found" publishedAt={null}>
      <p>Not found.</p>
    </PostLayout>
  )
}
