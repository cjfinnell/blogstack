---
import PostLayout from '../../layouts/PostLayout.astro';
import { postPublishedAt, postSlug, postTitle, renderLexicalToHtml } from '@blogstack/blog-client';
import { blog } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await blog.getPublishedPosts(100);
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const html = renderLexicalToHtml(post.data?.content);
---

<PostLayout title={postTitle(post)} publishedAt={postPublishedAt(post)}>
	<Fragment set:html={html} />
</PostLayout>
