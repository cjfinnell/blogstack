---
import SharedPostLayout from '@blogstack/astro-shared/PostLayout.astro';
import BaseLayout from './BaseLayout.astro';
import { theme } from '../site';

interface Props {
  title: string;
  publishedAt: string | null;
}

const { title, publishedAt } = Astro.props;
---

<SharedPostLayout layout={BaseLayout} theme={theme} title={title} publishedAt={publishedAt}>
  <slot />
</SharedPostLayout>
