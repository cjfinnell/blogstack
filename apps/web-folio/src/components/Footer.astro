---
const year = new Date().getFullYear();
---

<footer>
  <p>&copy; {year}</p>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
  }
  footer p {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
</style>
