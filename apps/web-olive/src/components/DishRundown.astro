---
import type { Dish } from '@blogstack/blog-client';

/**
 * "What we ordered" — renamed from "What to order" at her request.
 *
 * Dish, photograph, verdict. This is the block that gets shared, and it was a
 * single free-text line before.
 */

interface Props {
  dishes: Dish[];
  heading: string;
}

const { dishes, heading } = Astro.props;
---

{
  dishes.length > 0 && (
    <section class="rundown">
      <h2 class="section-label">{heading}</h2>
      {dishes.map((dish) => (
        <article class="dish">
          {dish.photo?.src && (
            <span class="thumb">
              <img src={dish.photo.src} alt={dish.photo.alt ?? ''} loading="lazy" />
            </span>
          )}
          <div>
            <h3>
              {dish.name}
              {dish.verdict === 'must' && <span class="must">Must order</span>}
              {dish.verdict === 'skip' && <span class="skip">Skip</span>}
            </h3>
            {dish.note && <p>{dish.note}</p>}
          </div>
        </article>
      ))}
    </section>
  )
}

<style>
  .section-label {
    font-family: var(--display);
    font-size: 2rem;
    margin: 3rem 0 1.25rem;
  }
  .dish {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--rule);
  }
  /* No photograph yet: the note takes the full width rather than leaving a
     hole where the image would go. */
  .dish:not(:has(.thumb)) {
    grid-template-columns: minmax(0, 1fr);
  }
  .thumb {
    border: 1px solid var(--rule);
    background: var(--surface);
    padding: 0.375rem;
    display: block;
  }
  .thumb img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.375rem;
    margin: 0 0 0.35rem;
  }
  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .must,
  .skip {
    font-family: var(--body);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    margin-left: 0.5rem;
    vertical-align: 0.18em;
  }
  .must {
    background: var(--navy);
    color: var(--cream);
  }
  .skip {
    border: 1px solid var(--rule-strong);
    color: var(--muted);
  }
  @media (max-width: 44rem) {
    .dish {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
