---
import Wordmark from './Wordmark.astro';
import Bow from './Bow.astro';
import SearchField from './SearchField.astro';
import ThemeToggle from '@blogstack/astro-shared/ThemeToggle.astro';
import type { SiteSettings } from '@blogstack/blog-client';

/**
 * One persistent global header on every page, identical furniture throughout,
 * in three size steps.
 *
 * Maria asked whether the same header everywhere was right. It is, and her own
 * reason is the correct one: it makes things less confusing, especially for
 * people who are less tech savvy.
 *
 * Inner pages get one compact row: wordmark and bow, nav, search, utilities.
 * Home gives the brand its own centred line above that row, and the tagline
 * below it; the search hints sit under the search pill. Below 68rem the nav
 * folds into the drawer. Every string comes from the CMS.
 */

interface Props {
  settings: SiteSettings;
  size: 'home' | 'map' | 'review';
  /** Nav label of the current section, for aria-current. */
  current?: string | undefined;
}

const { settings, size, current } = Astro.props;

const bowWidth = size === 'home' ? 96 : 34;
const placeholder = size === 'map' ? settings.searchPlaceholderMap : settings.searchPlaceholder;
---

<header class:list={['masthead', `is-${size}`]}>
  <div class="wrap-wide bar">
    <div class="brand">
      <Wordmark size={size} siteName={settings.siteName} />
      <Bow width={bowWidth} />
    </div>

    <nav class="primary">
      {
        settings.primaryNav.map((link) => (
          <a
            href={link.href}
            class:list={{ on: current === link.label }}
            aria-current={current === link.label ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a class="tip" href={settings.tipJarHref}>{settings.tipJarLabel}</a>
    </nav>

    <div class="search-slot">
      <SearchField
        placeholder={placeholder}
        hints={size === 'home' ? settings.searchHints : undefined}
        compact
      />
    </div>

    <div class="utility">
      <ThemeToggle />
      <details class="menu">
        <summary aria-label={settings.siteName}>
          <span></span><span></span><span></span>
        </summary>
        <nav class="drawer">
          {settings.primaryNav.map((link) => <a href={link.href}>{link.label}</a>)}
          <a href={settings.tipJarHref}>{settings.tipJarLabel}</a>
        </nav>
      </details>
    </div>
  </div>

  {
    size === 'home' && (
      <div class="wrap home-extra">
        <p class="tagline">{settings.tagline}</p>
      </div>
    )
  }
  <hr class="rule-full" />
</header>

<style>
  .masthead {
    position: relative;
  }

  /* Inner pages: one row. Brand left, nav centre, search and utilities right. */
  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    grid-template-areas: 'brand nav search utility';
    align-items: center;
    column-gap: 1.5rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }
  .brand {
    grid-area: brand;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  nav.primary {
    grid-area: nav;
  }
  .search-slot {
    grid-area: search;
    width: 16rem;
  }
  .utility {
    grid-area: utility;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* Home: the brand gets its own centred line, nav and search share the next. */
  .is-home .bar {
    grid-template-columns: 1fr auto auto;
    grid-template-areas:
      'brand brand brand'
      'nav search utility';
    row-gap: 1rem;
    padding-top: 1.5rem;
    /* The hints hang below the pill, so the row lines up on the pill, not the
       pill-plus-hints box. */
    align-items: start;
  }
  .is-home nav.primary,
  .is-home .utility {
    min-height: 2.3rem;
  }
  .is-home .brand {
    flex-direction: column;
    gap: 0.25rem;
  }
  .is-home .search-slot {
    width: 20rem;
  }

  /* The drawer is a <details>, so the secondary nav works with no JavaScript.
     It only appears once the inline nav no longer fits. */
  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    list-style: none;
    cursor: pointer;
    padding: 0.5rem;
    line-height: 0;
    color: var(--navy);
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    margin: 4px 0;
  }
  .drawer {
    position: absolute;
    right: 0;
    top: 100%;
    display: grid;
    min-width: 12rem;
    background: var(--cream);
    border: 1px solid var(--navy);
    padding: 0.5rem 0;
    z-index: 5;
  }
  .drawer a {
    padding: 0.5rem 1.25rem;
    text-decoration: none;
    color: var(--navy);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .drawer a:hover {
    background: var(--blue-wash);
  }

  nav.primary {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: nowrap;
    gap: 1.5rem;
  }
  .is-home nav.primary {
    justify-content: flex-start;
  }
  nav.primary a {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy);
    text-decoration: none;
    white-space: nowrap;
    padding: 0.35rem 0;
    font-weight: 500;
    border-bottom: 1.5px solid transparent;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  nav.primary a:hover,
  nav.primary a.on {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  nav.primary a.tip {
    letter-spacing: 0.12em;
    color: var(--muted);
    font-size: 0.6875rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
  }
  nav.primary a.tip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .home-extra {
    text-align: center;
  }
  .tagline {
    font-family: var(--display);
    font-style: italic;
    font-size: 1.125rem;
    color: var(--muted);
    margin: 0.75rem 0 1.25rem;
  }

  /* Narrower: the inline nav folds into the drawer. */
  @media (max-width: 68rem) {
    nav.primary {
      display: none;
    }
    .menu {
      display: block;
    }
    .bar,
    .is-home .bar {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand search utility';
    }
    .is-home .bar {
      grid-template-areas:
        'brand brand brand'
        'search search utility';
    }
    .search-slot,
    .is-home .search-slot {
      width: auto;
      justify-self: end;
      max-width: 20rem;
      width: 100%;
    }
  }

  /* Phones: search drops to its own full-width line. */
  @media (max-width: 40rem) {
    .bar {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'brand utility'
        'search search';
      row-gap: 0.75rem;
    }
    .is-home .bar {
      grid-template-areas:
        'brand brand'
        'search utility';
    }
    .search-slot,
    .is-home .search-slot {
      max-width: none;
    }
  }
</style>
