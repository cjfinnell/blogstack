---
import Wordmark from './Wordmark.astro';
import Bow from './Bow.astro';
import SearchField from './SearchField.astro';
import ThemeToggle from '@blogstack/astro-shared/ThemeToggle.astro';
import type { SiteSettings } from '@blogstack/blog-client';

/**
 * One persistent global header on every page, identical furniture throughout,
 * in three size steps.
 *
 * Maria asked whether the same header everywhere was right. It is, and her own
 * reason is the correct one: it makes things less confusing, especially for
 * people who are less tech savvy.
 *
 * Every page gets the same compact bar, sticky at the top: wordmark and bow,
 * nav, search, utilities. Below 68rem the nav folds into the drawer.
 *
 * Home adds a full-screen hero under it: the large wordmark, bow, tagline and
 * search. As the reader scrolls, the hero shrinks away and the bar's furniture
 * fades in, so the brand reads as moving up into the bar. That is a CSS
 * scroll-driven animation, no JavaScript; browsers without it, and readers who
 * ask for reduced motion, get the bar fully shown from the start. Every string
 * comes from the CMS.
 */

interface Props {
  settings: SiteSettings;
  size: 'home' | 'map' | 'review';
  /** Nav label of the current section, for aria-current. */
  current?: string | undefined;
}

const { settings, size, current } = Astro.props;

const placeholder = size === 'map' ? settings.searchPlaceholderMap : settings.searchPlaceholder;
---

<header class:list={['masthead', `is-${size}`]}>
  <div class="wrap-wide bar">
    <div class="brand">
      <Wordmark size={size === 'home' ? 'review' : size} siteName={settings.siteName} />
      <Bow width={34} />
    </div>

    <nav class="primary">
      {
        settings.primaryNav.map((link) => (
          <a
            href={link.href}
            class:list={{ on: current === link.label }}
            aria-current={current === link.label ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a class="tip" href={settings.tipJarHref}>{settings.tipJarLabel}</a>
    </nav>

    <div class="search-slot">
      <SearchField placeholder={placeholder} compact />
    </div>

    <div class="utility">
      <ThemeToggle icons />
      <details class="menu">
        <summary aria-label={settings.siteName}>
          <span></span><span></span><span></span>
        </summary>
        <nav class="drawer">
          {settings.primaryNav.map((link) => <a href={link.href}>{link.label}</a>)}
          <a href={settings.tipJarHref}>{settings.tipJarLabel}</a>
        </nav>
      </details>
    </div>
  </div>
  <hr class="rule-full" />
</header>

{
  size === 'home' && (
    <section class="hero">
      <div class="hero-inner">
        <Wordmark size="home" siteName={settings.siteName} />
        <Bow width={168} />
        <p class="tagline">{settings.tagline}</p>
        <div class="hero-search">
          <SearchField id="home-search" placeholder={placeholder} hints={settings.searchHints} />
        </div>
      </div>
      <span class="cue" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </section>
  )
}

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--cream);
  }

  /* One row. Brand left, nav centre, search and utilities right. */
  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    grid-template-areas: 'brand nav search utility';
    align-items: center;
    column-gap: 1.5rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }
  .brand {
    grid-area: brand;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  nav.primary {
    grid-area: nav;
  }
  .search-slot {
    grid-area: search;
    width: 16rem;
  }
  .utility {
    grid-area: utility;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* The drawer is a <details>, so the secondary nav works with no JavaScript.
     It only appears once the inline nav no longer fits. */
  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    list-style: none;
    cursor: pointer;
    padding: 0.5rem;
    line-height: 0;
    color: var(--navy);
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    margin: 4px 0;
  }
  .drawer {
    position: absolute;
    right: 0;
    top: 100%;
    display: grid;
    min-width: 12rem;
    background: var(--cream);
    border: 1px solid var(--navy);
    padding: 0.5rem 0;
    z-index: 5;
  }
  .drawer a {
    padding: 0.5rem 1.25rem;
    text-decoration: none;
    color: var(--navy);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .drawer a:hover {
    background: var(--blue-wash);
  }

  nav.primary {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: nowrap;
    gap: 1.5rem;
  }
  nav.primary a {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy);
    text-decoration: none;
    white-space: nowrap;
    padding: 0.35rem 0;
    font-weight: 500;
    border-bottom: 1.5px solid transparent;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  nav.primary a:hover,
  nav.primary a.on {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  nav.primary a.tip {
    letter-spacing: 0.12em;
    color: var(--muted);
    font-size: 0.6875rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
  }
  nav.primary a.tip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Home hero: fills the first screen under the bar. */
  .hero {
    position: relative;
    min-height: calc(100svh - 4.5rem);
    display: grid;
    place-items: center;
    padding: 2rem var(--gutter) 4rem;
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 36rem;
  }
  .tagline {
    font-family: var(--display);
    font-style: italic;
    font-size: 1.375rem;
    color: var(--muted);
    margin: 0.5rem 0 1rem;
    text-align: center;
  }
  .hero-search {
    width: 100%;
  }
  .cue {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    width: 28px;
    margin-left: -14px;
    color: var(--muted);
  }

  /* The collapse. Only where the browser can tie animation to scroll, and only
     for readers who have not asked for less motion; everyone else keeps the
     static layout above, bar fully shown. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .is-home .bar > :not(.utility),
      .is-home .rule-full {
        animation: bar-in linear both;
        animation-timeline: scroll(root);
        animation-range: 35svh 70svh;
      }
      .hero-inner,
      .cue {
        animation: hero-out linear both;
        animation-timeline: scroll(root);
        animation-range: 0 65svh;
        transform-origin: 50% 0;
      }
    }
  }
  @keyframes bar-in {
    from {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
  }
  @keyframes hero-out {
    to {
      opacity: 0;
      transform: translateY(-12svh) scale(0.55);
    }
  }

  /* Narrower: the inline nav folds into the drawer. */
  @media (max-width: 68rem) {
    nav.primary {
      display: none;
    }
    .menu {
      display: block;
    }
    .bar {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand search utility';
    }
    .search-slot {
      justify-self: end;
      max-width: 20rem;
      width: 100%;
    }
  }

  /* Phones: search drops to its own full-width line. */
  @media (max-width: 40rem) {
    .bar {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'brand utility'
        'search search';
      row-gap: 0.75rem;
    }
    .search-slot {
      max-width: none;
    }
    /* On home the hero already carries the search, so the bar stays one row. */
    .is-home .search-slot {
      display: none;
    }
    .is-home .bar {
      grid-template-areas: 'brand utility';
    }
  }
</style>
