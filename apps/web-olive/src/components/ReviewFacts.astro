---
import type { ReviewFact } from '@blogstack/blog-client';

/**
 * The review's labelled facts — Recommendation, Best occasion, Best dishes,
 * Reservations and whatever else Maria leads with a bold label — as one card
 * in place of the paragraphs she typed them as. See extractReviewFacts for how
 * the run is found.
 *
 * The labels are hers, read from the post, so a new label needs no code. Long
 * entries take the full width and short ones pair up, so a one-line
 * "Reservations" does not get a whole row to itself.
 */

interface Props {
  facts: ReviewFact[];
}

const { facts } = Astro.props;

// Rough character count of the rendered text, markup excluded. Long entries
// take two of the three columns; short ones take one.
const WIDE_AT = 220;
const textLength = (html: string): number => html.replace(/<[^>]+>/g, '').length;
---

<dl class="review-facts">
  {
    facts.map((fact, i) => (
      <div class:list={['fact', { lead: i === 0, wide: i > 0 && textLength(fact.html) > WIDE_AT }]}>
        <dt>{fact.label}</dt>
        <dd set:html={fact.html} />
      </div>
    ))
  }
</dl>

<style>
  /* Separate tiles rather than one panel, so each fact reads as its own thing.
     The first — her recommendation, in practice — leads, inverted in navy. */
  .review-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-flow: row dense;
    gap: 0.75rem;
    margin: 2.5rem 0 3rem;
  }
  .fact {
    padding: 1.1rem 1.25rem 1.2rem;
    background: var(--cream);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--baby);
    border-radius: 6px;
    box-shadow: 0 10px 24px -14px var(--card-shadow);
  }
  .fact.wide {
    grid-column: span 2;
  }
  .fact.lead {
    grid-column: span 2;
    grid-row: span 2;
    background: var(--navy);
    border-color: var(--navy);
    border-top-color: var(--accent);
    padding: 1.5rem 1.75rem;
  }
  dt {
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 0.4rem;
  }
  dd {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink);
    text-wrap: pretty;
  }
  .lead dt {
    color: var(--baby);
  }
  .lead dd {
    font-family: var(--display);
    font-size: 1.6rem;
    line-height: 1.3;
    color: var(--cream);
  }
  /* Her sentences start lower-case after the label; standing alone they read
     better capitalised. */
  dd::first-letter {
    text-transform: uppercase;
  }

  /* Breaks out of the text measure and past the card's edges, the same as the
     photographs. */
  @media (min-width: 68rem) {
    .review-facts {
      margin: 3rem -7rem 3.5rem;
    }
  }
  @media (max-width: 40rem) {
    .review-facts {
      grid-template-columns: minmax(0, 1fr);
    }
    .fact.wide,
    .fact.lead {
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>
