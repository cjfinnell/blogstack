---
import { compositeScore, ownRating, reviewAxes, SCORE_MAX } from '@blogstack/blog-client';
import type { ReviewMeta, ReviewRating, ReviewScaleStep } from '@blogstack/blog-client';

/**
 * The composite and the headline axes, as a full-width strip.
 *
 * This is the fix for the reported bug. The mockup parked the score in a 14rem
 * left margin: `.marginalia` was pinned to column 1 and therefore occupied
 * exactly one auto-placed row, so `position: sticky` could not travel, the
 * score stranded at the top, and the column was dead from row 3 down — which is
 * what "the text also goes over the what to order section" was describing. The
 * margin column is gone and nothing here is sticky.
 *
 * It also serves the thing she actually praised — "I really like kind of this
 * scorecard that's colourful and very easy to read" — better than a margin
 * does.
 *
 * The number is always visible as a numeral. Never colour alone: that survives
 * colourblindness, CSS failure and zoom, none of which a coloured bar does.
 */

interface Props {
  review: ReviewMeta;
  /** Where the rubric explainer lives. */
  rubricHref?: string | undefined;
  /** The rating as the review states it ("2.3 / 4. It was good…"), if it does. */
  rating?: ReviewRating | null | undefined;
  /** The review's own scale legend ("1 - Bad · 2 - Good · …"). */
  scale?: ReviewScaleStep[] | undefined;
}

const { review, rubricHref = '/rubric', rating = null, scale = [] } = Astro.props;

const axes = reviewAxes(review).filter((a) => a.value !== null);

// With no axes scored, the review's own scale replaces the composite and its
// rubric link. See ownRating.
const own = ownRating(review, rating);
const tier = own ? scale.findLast((step) => step.value <= own.value) : undefined;
const composite = own ? null : compositeScore(review);
// The legend's steps are spread end to end, first step at the left edge, so
// the bar runs from the lowest step rather than from zero.
const low = scale[0]?.value ?? 0;
const fill = own ? Math.min(100, Math.max(0, ((own.value - low) / (own.max - low)) * 100)) : 0;
---

<section class:list={['scorecard', { own }]}>
  <div class="headline">
    {
      own ? (
        <span class="score tnum">
          {own.value}
          <span class="of">/ {own.max}</span>
        </span>
      ) : composite === null ? (
        <span class="unrated">Unrated</span>
      ) : (
        <span class="score tnum">{composite.toFixed(1)}</span>
      )
    }
    {
      own ? (
        tier && <span class="tier">{tier.label}</span>
      ) : (
        <span class="denominator">
          {composite === null
            ? 'Not enough visits to score'
            : `Composite out of ${String(SCORE_MAX)}`}
          {' · '}
          <a href={rubricHref}>how we score</a>
        </span>
      )
    }
  </div>

  {
    own && (
      <div class="own-rating">
        {own.html && <p class="note" set:html={own.html} />}
        {scale.length > 0 && (
          <div class="scale">
            <span
              class="bar"
              role="img"
              aria-label={`${String(own.value)} out of ${String(own.max)}`}
            >
              <i style={`width:${String(fill)}%`} />
            </span>
            <ol>
              {scale.map((step) => (
                <li class:list={{ on: step === tier }}>
                  <span class="tnum">{step.value}</span> {step.label}
                </li>
              ))}
            </ol>
          </div>
        )}
      </div>
    )
  }

  {
    axes.length > 0 && (
      <ul class="axes">
        {axes.map((axis) => (
          <li>
            <span class="label">{axis.label}</span>
            <span
              class="bar"
              role="img"
              aria-label={`${axis.label}: ${String(axis.value)} out of ${String(SCORE_MAX)}`}
            >
              <i style={`width:${String(axis.percent)}%`} />
            </span>
            <span class="val tnum">{axis.value?.toFixed(1)}</span>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .scorecard {
    display: grid;
    grid-template-columns: minmax(9rem, auto) minmax(0, 1fr);
    gap: 1.5rem 2.5rem;
    align-items: start;
    border-top: 1px solid var(--navy);
    border-bottom: 1px solid var(--navy);
    padding: 1.75rem 0;
    margin: 0 0 2rem;
  }

  .score {
    display: block;
    font-family: var(--display);
    font-weight: 500;
    font-size: 4.5rem;
    line-height: 0.9;
    color: var(--accent);
  }
  .score .of {
    font-size: 1.75rem;
    color: var(--muted);
    margin-left: 0.15em;
  }
  .tier {
    display: block;
    font-family: var(--display);
    font-size: 1.5rem;
    color: var(--navy);
    margin-top: 0.4rem;
  }
  .note {
    margin: 0 0 1.1rem;
    font-family: var(--display);
    font-size: 1.3rem;
    line-height: 1.35;
    color: var(--navy);
    text-wrap: pretty;
  }
  .scale .bar {
    display: block;
  }
  .scale ol {
    display: flex;
    justify-content: space-between;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .scale li.on {
    color: var(--accent);
    font-weight: 600;
  }
  .unrated {
    display: block;
    font-family: var(--display);
    font-weight: 500;
    font-size: 2.25rem;
    line-height: 1;
    color: var(--muted);
  }
  .denominator {
    display: block;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.5rem;
  }

  .axes {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }
  .axes li {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr) 2.5rem;
    gap: 1rem;
    align-items: center;
  }
  .label {
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .bar {
    height: 6px;
    background: var(--rule);
    border-radius: 999px;
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    background: var(--accent);
  }
  .val {
    text-align: right;
    font-family: var(--display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--navy);
  }

  @media (max-width: 48rem) {
    .scorecard {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
    .axes li {
      grid-template-columns: minmax(0, 1fr) 2.5rem;
    }
    .bar {
      grid-column: 1 / -1;
      order: 3;
    }
  }
</style>
