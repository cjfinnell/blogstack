---
// Deliberately does not use BaseLayout or import `blog`: this shell must
// not inherit the theme the mockups are proposing to replace, and it must
// build even if the CMS is unreachable.
//
// Round 1 offered seven competing concepts; Maria picked D outright, so
// pages 1-3 are not alternatives to each other — they are one design system
// shown across the three page types. See notes/round-1-feedback.md.
//
// Page 0 is a decision sheet rather than a page design: after round 2 the
// only thing still blocking the real build is the wordmark and the bow, so
// those get settled on their own. See notes/round-2-feedback.md.
const pages = [
  {
    key: '0',
    file: '0-identity.html',
    name: 'Identity',
    blurb: 'Decision sheet: seven scripts and four bows, to pick one of each. Start here.',
  },
  {
    key: '1',
    file: '1-home.html',
    name: 'Home',
    blurb: 'Concept D refined: whimsier wordmark, fuller bow, her four colours, search promoted.',
  },
  {
    key: '2',
    file: '2-map.html',
    name: 'Map & lists',
    blurb: "Concept F's map and saved lists in D's skin, with B's rankings ledger under the map.",
  },
  {
    key: '3',
    file: '3-review.html',
    name: 'A review',
    blurb: "Concept A's article structure with D's seven-axis rubric and C's rubric explainer.",
  },
];

const notes = [
  { href: '/mockups/notes/round-2-feedback.md', label: 'Round 2 feedback → next' },
  { href: '/mockups/notes/round-1-feedback.md', label: 'Round 1 feedback' },
  { href: '/mockups/notes/source-essences.md', label: 'Source essences' },
  { href: '/mockups/notes/mockup-audit.md', label: 'Round 1 audit' },
  { href: '/mockups/notes/maria-inspo-notes.md', label: "Maria's inspiration notes" },
  { href: '/mockups/notes/olive-design-proposal.md', label: 'Design proposal' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Olive mockup gallery</title>
    <style>
      :root {
        color-scheme: light;
        --shell-bg: #f4f4f2;
        --shell-fg: #2a2a28;
        --shell-muted: #6b6b66;
        --shell-border: #d8d8d2;
        --shell-accent: #3a3a36;
        --sidebar-w: 260px;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        height: 100%;
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        color: var(--shell-fg);
        background: var(--shell-bg);
      }
      .layout {
        display: grid;
        grid-template-columns: var(--sidebar-w) 1fr;
        height: 100vh;
      }
      nav.sidebar {
        border-right: 1px solid var(--shell-border);
        overflow-y: auto;
        padding: 1rem 0 2rem;
      }
      .sidebar h1 {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--shell-muted);
        margin: 0 1rem 0.25rem;
      }
      .sidebar .standfirst {
        margin: 0 1rem 0.75rem;
        font-size: 0.78rem;
        line-height: 1.4;
        color: var(--shell-muted);
      }
      .sidebar ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .sidebar a {
        display: block;
        padding: 0.6rem 1rem;
        text-decoration: none;
        color: var(--shell-fg);
        border-left: 3px solid transparent;
      }
      .sidebar a:hover {
        background: rgba(0, 0, 0, 0.04);
      }
      .sidebar a.active {
        border-left-color: var(--shell-accent);
        background: rgba(0, 0, 0, 0.05);
      }
      .sidebar .key {
        display: inline-block;
        width: 1.25rem;
        font-variant-numeric: tabular-nums;
        font-weight: 600;
        color: var(--shell-muted);
      }
      .sidebar .name {
        font-weight: 600;
      }
      .sidebar .blurb {
        display: block;
        margin-top: 0.15rem;
        margin-left: 1.25rem;
        font-size: 0.78rem;
        color: var(--shell-muted);
        line-height: 1.3;
      }
      .sidebar .notes-group {
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--shell-border);
      }
      .sidebar .notes-group a {
        font-size: 0.85rem;
        color: var(--shell-muted);
        padding: 0.4rem 1rem;
      }
      main.pane {
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .pane-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.5rem 1rem;
        border-bottom: 1px solid var(--shell-border);
        font-size: 0.8rem;
        color: var(--shell-muted);
      }
      .pane-header a {
        color: var(--shell-accent);
        text-decoration: none;
      }
      .pane-header a:hover {
        text-decoration: underline;
      }
      #viewport-readout {
        font-variant-numeric: tabular-nums;
      }
      iframe#mockup-frame {
        flex: 1;
        width: 100%;
        border: 0;
        background: #fff;
      }

      @media (max-width: 900px) {
        .layout {
          grid-template-columns: 1fr;
          grid-template-rows: auto 1fr;
        }
        nav.sidebar {
          border-right: 0;
          border-bottom: 1px solid var(--shell-border);
          overflow-x: auto;
          overflow-y: hidden;
          white-space: nowrap;
          padding: 0.75rem;
        }
        .sidebar h1,
        .sidebar .standfirst {
          display: none;
        }
        .sidebar ul {
          display: flex;
          gap: 0.5rem;
        }
        .sidebar a {
          border-left: none;
          border-bottom: 3px solid transparent;
          white-space: nowrap;
        }
        .sidebar a.active {
          border-left-color: transparent;
          border-bottom-color: var(--shell-accent);
        }
        .sidebar .blurb {
          display: none;
        }
        .sidebar .notes-group {
          display: flex;
          margin-top: 0;
          padding-top: 0;
          border-top: 0;
          border-left: 1px solid var(--shell-border);
          margin-left: 0.5rem;
          padding-left: 0.5rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="layout">
      <nav class="sidebar" aria-label="Mockup pages">
        <h1>Olive — round 2</h1>
        <p class="standfirst">
          Start at 0 — it is the one open decision. Pages 1-3 are one direction, not alternatives to
          each other; they share a palette, a wordmark and a masthead on purpose.
        </p>
        <ul>
          {
            pages.map((p) => (
              <li>
                <a
                  href={`/mockups/${p.file}`}
                  data-key={p.key}
                  data-file={p.file}
                  data-name={p.name}
                >
                  <>
                    <span class="key">{p.key}</span>
                    <span class="name">{p.name}</span>
                  </>
                  <span class="blurb">{p.blurb}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="notes-group">
          <ul>
            {
              notes.map((n) => (
                <li>
                  <a href={n.href} target="_blank" rel="noopener">
                    {n.label}
                  </a>
                </li>
              ))
            }
            <li><a href="/">↩ Live olive site</a></li>
          </ul>
        </div>
      </nav>
      <main class="pane">
        <div class="pane-header">
          <a id="standalone-link" href="/mockups/0-identity.html" target="_blank" rel="noopener"
            >Open standalone ↗</a
          >
          <span id="viewport-readout">— × —</span>
        </div>
        <iframe id="mockup-frame" title="Olive mockup" src="/mockups/0-identity.html"></iframe>
      </main>
    </div>
    <script>
      type Page = { key: string; file: string; name: string; el: HTMLAnchorElement };

      const pages: Page[] = [];
      document.querySelectorAll<HTMLAnchorElement>('.sidebar a[data-key]').forEach((a) => {
        pages.push({
          key: a.dataset.key ?? '',
          file: a.dataset.file ?? '',
          name: a.dataset.name ?? '',
          el: a,
        });
      });

      const frame = document.getElementById('mockup-frame') as HTMLIFrameElement;
      const standaloneLink = document.getElementById('standalone-link') as HTMLAnchorElement;
      const readout = document.getElementById('viewport-readout') as HTMLSpanElement;

      function selectKey(key: string) {
        const match = pages.find((p) => p.key === key) || pages[0];
        if (!match) return;
        frame.src = `/mockups/${match.file}`;
        frame.title = match.name;
        standaloneLink.href = `/mockups/${match.file}`;
        pages.forEach((p) => p.el.classList.toggle('active', p.key === match.key));
      }

      function keyFromHash() {
        const h = location.hash.replace('#', '');
        return h || '0';
      }

      function updateReadout() {
        readout.textContent = `${window.innerWidth} × ${window.innerHeight}`;
      }

      // Rewrite plain standalone links into hash links now that JS is confirmed
      // running; without this script, the anchors above still work as direct
      // links to each standalone mockup.
      pages.forEach((p) => {
        p.el.setAttribute('href', `#${p.key}`);
        p.el.addEventListener('click', (e) => {
          e.preventDefault();
          location.hash = p.key;
        });
      });

      window.addEventListener('hashchange', () => selectKey(keyFromHash()));
      window.addEventListener('resize', updateReadout);

      if (!location.hash) location.hash = '0';
      selectKey(keyFromHash());
      updateReadout();
    </script>
  </body>
</html>
