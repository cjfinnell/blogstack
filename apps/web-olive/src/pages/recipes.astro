---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSettings } from '../lib/settings';

const settings = await getSettings();
---

<BaseLayout title={`Recipes | ${settings.siteName}`} description={settings.tagline}>
  <div class="wrap page">
    <h1>Recipes</h1>
    <p>
      Coming soon. Recipes don't have a content model yet — this is a placeholder route so the nav
      link resolves.
    </p>
    <p><a href="/posts">See all posts &rarr;</a></p>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: 3rem 5rem;
  }
</style>
