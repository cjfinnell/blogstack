---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { blog } from '@blogstack/astro-shared/blog';

export const prerender = import.meta.env.RENDER_MODE !== 'ssr';

const posts = await blog.getPublishedPosts(100);
---

<BaseLayout title="Blog | All posts" description="All posts">
  <h1>All posts</h1>
  {posts.length === 0 && <p>No posts published yet.</p>}
  {posts.map((post) => <PostCard post={post} />)}
</BaseLayout>
