---
import PostLayout from '../../layouts/PostLayout.astro';
import ReviewLayout from '../../layouts/ReviewLayout.astro';
import { postPublishedAt, postSlug, postTitle, reviewMeta } from '@blogstack/blog-client';
import { blog } from '@blogstack/astro-shared/blog';
import { optimizePostImages, renderPostHtml } from '@blogstack/astro-shared/post-html';
import { theme } from '../../site';

export const prerender = import.meta.env.RENDER_MODE !== 'ssr';

export async function getStaticPaths() {
  if (!prerender) return [];
  const posts = await blog.getPublishedPosts(100);
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const post = Astro.props.post ?? (await blog.getPostBySlug(Astro.params.slug));
if (!post) Astro.response.status = 404;
const review = post ? reviewMeta(post) : null;
const rendered = post ? await renderPostHtml(post.data?.content, theme) : null;
// Only the static build resizes body images. The draft Worker would refetch
// every upload on every request to infer its size, so drafts keep the CMS
// originals.
const html =
  rendered && prerender
    ? await optimizePostImages(rendered, {
        cmsUrl: import.meta.env.CMS_URL ?? 'http://localhost:8787',
        // The rendered column: the review reading column is 42rem, a plain
        // post fills the 64rem wrap.
        sizes: review ? '(min-width: 42rem) 42rem, 100vw' : '(min-width: 64rem) 64rem, 100vw',
      })
    : rendered;
---

{
  !post ? (
    <PostLayout title="404 — not found" publishedAt={null}>
      <p>Not found.</p>
    </PostLayout>
  ) : review ? (
    <ReviewLayout title={postTitle(post)} publishedAt={postPublishedAt(post)} review={review}>
      <Fragment set:html={html} />
    </ReviewLayout>
  ) : (
    <PostLayout title={postTitle(post)} publishedAt={postPublishedAt(post)}>
      <Fragment set:html={html} />
    </PostLayout>
  )
}
