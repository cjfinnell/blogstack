---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSettings } from '../lib/settings';

const settings = await getSettings();
---

<BaseLayout title={`${settings.tipJarLabel} | ${settings.siteName}`} description={settings.tagline}>
  <div class="wrap page">
    <h1>{settings.tipJarLabel}</h1>
    <p class="pledge">{settings.pledge.statement}</p>

    <ul class="tiers">
      {
        settings.tipTiers.map((tier) => (
          <li>
            <a href={tier.href}>
              <span class="amount">{tier.amount}</span>
              <span class="description">{tier.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: 3rem 5rem;
    max-width: 42rem;
  }
  .pledge {
    color: var(--muted);
  }
  .tiers {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .tiers a {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--rule-strong);
    border-radius: 0.5rem;
    text-decoration: none;
  }
  .amount {
    font-family: var(--display);
    font-size: 1.25rem;
    color: var(--navy);
  }
  .description {
    color: var(--muted);
  }
</style>
