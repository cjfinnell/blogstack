---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { blog } from '@blogstack/astro-shared/blog';

const posts = await blog.getPublishedPosts(5);
---

<BaseLayout
  title="Maria Eleni"
  description="Writing on food, hospitality, and the business of both."
>
  <h1>Latest posts</h1>
  {posts.length === 0 && <p>No posts published yet.</p>}
  {posts.map((post) => <PostCard post={post} />)}
  {
    posts.length > 0 && (
      <p style="margin-top: 1.5rem;">
        <a href="/posts">View all posts &rarr;</a>
      </p>
    )
  }
</BaseLayout>
