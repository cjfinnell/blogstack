---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { blog } from '@blogstack/astro-shared/blog';
import { getSettings } from '../lib/settings';

const posts = await blog.getPublishedPosts(5);
const settings = await getSettings();
---

<BaseLayout title={settings.siteName} description={settings.tagline}>
  <div class="wrap page">
    <h1>Latest posts</h1>
    {posts.length === 0 && <p>No posts published yet.</p>}
    {posts.map((post) => <PostCard post={post} />)}
    {
      posts.length > 0 && (
        <p class="view-all">
          <a href="/posts">View all posts &rarr;</a>
        </p>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: 3rem 5rem;
  }
  .view-all {
    margin-top: 1.5rem;
  }
</style>
