---

<header>
  <nav>
    <a href="/" class="brand">~/blog</a>
    <a href="/blog">all posts</a>
    <a href="/rss.xml">rss</a>
  </nav>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border);
  }
  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .brand {
    font-weight: 700;
    text-decoration: none;
    color: var(--accent);
  }
  nav a:not(.brand) {
    text-decoration: none;
    color: var(--muted);
  }
  nav a:not(.brand)::before {
    content: '$ ';
  }
  nav a:not(.brand):hover {
    color: var(--fg);
  }
</style>
