---
const year = new Date().getFullYear();
---

<footer>
  <p>// {year}</p>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.8rem;
  }
  footer p {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.5rem 1.25rem;
  }
</style>
