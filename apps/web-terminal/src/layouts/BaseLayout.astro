---
import SharedBaseLayout from '@blogstack/astro-shared/BaseLayout.astro';
import { theme, brand, links, footerText } from '../site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A developer blog.' } = Astro.props;
---

<SharedBaseLayout
  title={title}
  description={description}
  theme={theme}
  brand={brand}
  links={links}
  footerText={footerText}
>
  <slot />
</SharedBaseLayout>
