---
import type { Post } from '@blogstack/blog-client';
import { postPublishedAt, postSlug, postTitle } from '@blogstack/blog-client';

interface Props {
  post: Post;
  basePath: string;
}

const { post, basePath } = Astro.props;
const publishedAt = postPublishedAt(post);
---

<article class="card">
  <h2><a href={`${basePath}/${postSlug(post)}/`}>{postTitle(post)}</a></h2>
  {
    publishedAt && (
      <time datetime={publishedAt} class="date">
        {new Date(publishedAt).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
    )
  }
</article>

<style>
  .card {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }
  .card h2 {
    margin: 0 0 0.25rem;
    font-size: 1.25rem;
  }
  .card a {
    text-decoration: none;
    color: var(--fg);
  }
  .card a:hover {
    color: var(--accent);
  }
  .date {
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
