{
  "name": "blogstack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "gen-wrangler": "tsx scripts/gen-wrangler.ts",
    "ci-gen-wrangler": "tsx scripts/ci-gen-wrangler.ts",
    "resolve-deploy-matrix": "tsx scripts/resolve-deploy-matrix.ts",
    "dev:cms": "npm run gen-wrangler && wrangler dev --env dev",
    "dev:web": "tsx scripts/dev-web.ts",
    "db:migrate:local": "npm run gen-wrangler && wrangler d1 migrations apply DB --local --env dev",
    "seed": "tsx apps/cms/scripts/seed-admin.ts",
    "release": "tsx scripts/release.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "build:web-dev": "tsx scripts/build-web-dev-fixture.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "smol-toml": "^1.4.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.15",
    "wrangler": "^4.52.1"
  }
}
